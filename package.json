{
  "name": "desktop-robot",
  "version": "1.0.0",
  "description": "桌面机器人",
  "author": "Desktop Robot",
  "license": "MIT",
  "main": "main.js",
  "bin": {
    "robot-start": "./robot-start"
  },
  "scripts": {
    "start": "node scripts/start-electron.js",
    "test": "node --test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --publish never --config.mac.identity=null",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.20.1",
    "prettier": "3.5.3"
  },
  "dependencies": {
    "three": "^0.184.0",
    "uiohook-napi": "^1.5.5"
  },
  "allowScripts": {
    "electron@42.4.1": true,
    "electron-winstaller@5.4.0": true,
    "uiohook-napi@1.5.5": true
  },
  "build": {
    "appId": "com.desktoprobot.app",
    "productName": "Desktop Robot",
    "files": [
      "assets/**",
      "lib/**",
      "vendor/**",
      "scripts/**",
      "index.html",
      "main.js",
      "preload.js",
      "renderer-dom.js",
      "renderer-robot3d.js",
      "renderer-monitor.js",
      "renderer-settings.js",
      "renderer-chat.js",
      "renderer-reminder.js",
      "renderer-news.js",
      "renderer-translate.js",
      "renderer-effects.js",
      "renderer-todo.js",
      "renderer.js",
      "style.css",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
